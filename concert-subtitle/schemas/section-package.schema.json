{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-package.schema.json",
  "title": "Concert subtitle section package",
  "type": "object",
  "required": [
    "schema_version",
    "section_id",
    "section_type",
    "section_start",
    "section_end",
    "context_start",
    "context_end",
    "timeline_origin",
    "audio_path",
    "gpu_required",
    "manifest_section_hash",
    "input_hash"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "section_id": {"type": "string"},
    "section_type": {"enum": ["song", "mc"]},
    "section_start": {"type": "number"},
    "section_end": {"type": "number"},
    "context_start": {"type": "number"},
    "context_end": {"type": "number"},
    "timeline_origin": {"type": "number"},
    "audio_context_origin": {"type": "number"},
    "audio_path": {"type": "string"},
    "gpu_required": {"type": "boolean"},
    "manifest_section_hash": {"type": "string", "minLength": 64, "maxLength": 64},
    "lyrics_file": {"type": ["string", "null"]},
    "input_hash": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": true
}
