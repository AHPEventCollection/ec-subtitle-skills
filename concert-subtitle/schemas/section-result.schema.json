{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "section-result.schema.json",
  "title": "Concert subtitle section result",
  "type": "object",
  "required": ["schema_version", "section_id", "events"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "section_id": {"type": "string"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "source_text"],
        "properties": {
          "id": {"type": "string"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "exclusiveMinimum": 0},
          "source_text": {"type": "string", "minLength": 1},
          "translation": {"type": "string"},
          "singing_parts": {
            "type": "array", "minItems": 1,
            "items": {"$ref": "#/$defs/singing_part"}
          },
          "role": {
            "type": "string",
            "enum": ["lyric", "speech", "lyric_adlib"]
          },
          "canonical_source_text": {"type": "string", "minLength": 1},
          "lyric_line_span": {
            "type": "array",
            "prefixItems": [
              {"type": "integer", "minimum": 1},
              {"type": "integer", "minimum": 1}
            ],
            "minItems": 2,
            "maxItems": 2
          },
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "singing_part": {
      "type": "object",
      "required": ["text", "mode", "status"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "mode": {"enum": ["solo", "group", "unknown"]},
        "status": {"enum": ["candidate", "confirmed"]},
        "performer_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "color": {"type": ["string", "null"], "pattern": "^#[0-9A-Fa-f]{6}$"},
        "evidence": {
          "type": "array",
          "items": {
            "type": "object", "required": ["basis", "reference"],
            "properties": {
              "basis": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    }
  }
}
