{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concert-manifest.schema.json",
  "title": "Concert subtitle manifest",
  "type": "object",
  "required": [
    "schema_version",
    "concert_id",
    "source_media",
    "audio_path",
    "duration_seconds",
    "sections"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "concert_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_media": {"type": "string", "minLength": 1},
    "source_fingerprint": {"type": ["object", "null"]},
    "review_media": {"type": "string", "minLength": 1},
    "review_media_kind": {"enum": ["source", "transcoded_preview"]},
    "review_media_fingerprint": {"type": ["object", "null"]},
    "audio_path": {"type": "string", "minLength": 1},
    "setlist_path": {"type": ["string", "null"]},
    "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
    "coverage_policy": {
      "enum": ["full_timeline_asr", "legacy_section_only"]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "source_song_titles": {"type": "boolean"},
        "progress_bar": {
          "type": "object",
          "properties": {
            "x": {"type": "integer", "minimum": 0, "maximum": 1919},
            "y": {"type": "integer", "minimum": 0, "maximum": 1079},
            "width": {"type": "integer", "minimum": 1, "maximum": 1920},
            "height": {"type": "integer", "minimum": 1, "maximum": 1080}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/section"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "section": {
      "type": "object",
      "required": [
        "id",
        "order",
        "type",
        "start",
        "end",
        "context_start",
        "context_end",
        "status"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
        "order": {"type": "integer", "minimum": 1},
        "type": {"enum": ["song", "mc"]},
        "title": {"type": "string"},
        "source_song_title": {"type": "boolean"},
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "exclusiveMinimum": 0},
        "context_start": {"type": "number", "minimum": 0},
        "context_end": {"type": "number", "exclusiveMinimum": 0},
        "boundary_source": {"type": "string"},
        "boundary_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "lyrics_path": {"type": ["string", "null"]},
        "lyrics_source": {"type": ["string", "null"]},
        "lyrics_status": {
          "type": ["string", "null"],
          "enum": ["provided", "found", "not_found", null]
        },
        "lyrics_lookup": {"type": ["object", "null"]},
        "translation_path": {"type": ["string", "null"]},
        "translation_source": {"type": ["string", "null"]},
        "translation_status": {
          "type": ["string", "null"],
          "enum": ["provided", "found", "not_found", null]
        },
        "gpu_required": {"type": "boolean"},
        "review_priority": {"enum": ["normal", "high"]},
        "status": {
          "enum": [
            "planned",
            "prepared",
            "queued",
            "running",
            "needs_review",
            "approved",
            "failed",
            "stale"
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
